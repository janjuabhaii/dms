# ==========================================
# SERVER CONFIG
# ==========================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ==========================================
# DATABASE
# ==========================================
MONGODB_URI=mongodb://127.0.0.1:27017/dms_dev

# ==========================================
# AUTH / JWT
# ==========================================
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# ==========================================
# CLOUDINARY (Product & Shop images)
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

ADMIN_SEED_NAME=Business Owner
ADMIN_SEED_EMAIL=admin@dms.local
ADMIN_SEED_PASSWORD=Admin@12345


